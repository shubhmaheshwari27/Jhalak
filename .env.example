# Passcode your team types once to use the app (protects your API credits)
APP_PASSCODE=change-me

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# OpenAI (platform.openai.com -> API keys)
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium
OPENAI_TEXT_MODEL=gpt-5.6

# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=AIza...
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Which AI writes the saree description for Approach A: openai | gemini
SPEC_PROVIDER=openai
